---
import { cva, type VariantProps } from "class-variance-authority";
import { twMerge } from "tailwind-merge";
import clsx from "clsx";

// --- Variant definitions ---
const button = cva(
  [
    "inline-flex items-center justify-center gap-2",
    "font-heading font-medium rounded-full",
    "transition-colors duration-150",
    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2",
    "disabled:opacity-50 disabled:pointer-events-none",
  ],
  {
    variants: {
      variant: {
        primary:
          "bg-button-primary text-text-inverted hover:bg-button-primary-hover focus-visible:ring-focus-primary",
        secondary:
          "bg-button-secondary text-text-primary hover:bg-button-secondary-hover focus-visible:ring-focus-primary",
          
        /*
        outline:
          "border border-slate-300 text-slate-900 bg-transparent hover:bg-slate-50 focus-visible:ring-slate-400",
        ghost:
          "bg-transparent text-slate-700 hover:bg-slate-100 focus-visible:ring-slate-400",
        danger:
          "bg-red-600 text-white hover:bg-red-700 focus-visible:ring-red-500",
        */
      },
      size: {
        sm: "text-base px-4 py-2",
        md: "text-xl px-6 py-3",
        lg: "text-2xl px-8 py-4",
      },
      fullWidth: {
        true: "w-full",
        false: "",
      },
    },
    defaultVariants: {
      variant: "primary",
      size: "md",
      fullWidth: false,
    },
  }
);

export interface Props extends VariantProps<typeof button> {
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  loading?: boolean;
  class?: string;
  ariaLabel?: string;
  target?: string;
  rel?: string;
}

const {
  variant,
  size,
  fullWidth,
  href,
  type = "button",
  disabled = false,
  loading = false,
  class: className,
  ariaLabel,
  target,
  rel,
} = Astro.props;

// Merge cva classes with any custom classes passed in, letting later ones win
const classes = twMerge(clsx(button({ variant, size, fullWidth }), className));

// If it's a link, disabling isn't a native HTML concept — fake it via aria + pointer-events
const isLinkDisabled = href && disabled;
const Tag = href ? "a" : "button";
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  disabled={!href ? disabled || loading : undefined}
  aria-disabled={isLinkDisabled ? "true" : undefined}
  aria-label={ariaLabel}
  aria-busy={loading ? "true" : undefined}
  target={href ? target : undefined}
  rel={target === "_blank" ? "noopener noreferrer" : rel}
  tabindex={isLinkDisabled ? -1 : undefined}
  class:list={[isLinkDisabled && "opacity-50 pointer-events-none cursor-not-allowed"]}
>
  {loading && (
    <svg
      class="animate-spin h-4 w-4"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle
        class="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="4"
      ></circle>
      <path
        class="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
      ></path>
    </svg>
  )}

  {!loading && <slot name="icon-left" />}

  <slot />

  {!loading && <slot name="icon-right" />}
</Tag>