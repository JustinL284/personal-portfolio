---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
]
---

<nav class="nav-bar1">
  <ul class="nav-list1">
    {navItems1.map(item => (
      <li class="nav-item1">
        <a class="nav-link1" href={item.href}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-bar1 {
    display: flex;
    justify-content: center;
    padding: 1rem;
    background: #111;
  }

  .nav-list1 {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link1 {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }

  .nav-link1:hover1 {
    color: #0af;
  }
</style>
