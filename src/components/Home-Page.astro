---
import Button from '../components/Button.astro'
import DecryptedText from '../components/DecryptedText.jsx';
import ContentContainer from '../components/Content-Container.astro'
---
<!-- HERO HEADER -->
<main class="bg-surface-primary h-screen w-full flex items-center justify-center flex-col">
    <div class="flex flex-col items-center gap-8 text-center ">
        <h1 class="text-9xl">
            <span class="sr-only">Justin Lee</span>
            <DecryptedText
            text="JUSTIN LEE"
            speed={50}
            maxIterations={10}
            sequential
            revealDirection="start"
            animateOn="hover"
            className="revealed-text"
            encryptedClassName="scrambled-text"
            client:load
        />
        </h1>
        
        <div class="flex gap-8 list-none justify-center">
            <li>Front-End UI/UX Developer</li>
            <li>Chicago, IL</li>
            <li>Purdue UX Alumni</li>
            <li>LEGO Enthusiast</li>
        </div>
        <Button variant='primary' size='md' >View my work</Button>
    </div>
    <div class="absolute inset-x-0 bottom-0 px-8 py-6">
        <p class="text-xl font-heading text-text-secondary">Some text here</p>
    </div>
</main>

<!-- PROJECT SHOWCASE -->
<ContentContainer title="project showcase">
    <div class="flex flex-col items-center justify-center">
        <h1>SHOWCASE</h1>
        <p>This is a subtitle for Showcase.</p>
    </div>
</ContentContainer>

</section>

<!-- ABOUT ME SNIPPET -->
<ContentContainer title="about me">
    <div class="flex flex-row">
        <div>
            <h1>JUSTIN LEE</h1>
        </div>
        <div>
            <p>photo here</p>
        </div>
    </div>
</ContentContainer>
