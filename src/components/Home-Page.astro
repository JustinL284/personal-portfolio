---
import Button from '../components/Button.astro'
import SectionContainer from '../components/Section-Container.astro'
import ContentContainer from '../components/Content-Container.astro'
import ProjectCard from '../components/Project-Card.astro'
import FaultyTerminal from '../components/FaultyTerminal'
---

<!-- HERO HEADER -->
<main class="bg-surface-primary relative h-screen w-full flex items-center justify-center flex-col overflow-hidden">
    <!-- Background layer -->
    <div class="absolute inset-0 z-0">

        <FaultyTerminal
                dpr={1}
                scale={1.5}
                gridMul={[2, 1]}
                digitSize={1.2}
                timeScale={0.5}
                pause={false}
                scanlineIntensity={0.5}
                glitchAmount={1}
                flickerAmount={1}
                noiseAmp={1}
                chromaticAberration={0}
                dither={0}
                curvature={0.1}
                tint="#A7EF9E"
                mouseReact
                mouseStrength={0.5}
                pageLoadAnimation
                brightness={0.6}
                client:only="react"
            />

        <!--
        <Dither
            client:only="react"
            waveColor={[0.5,0.5,0.5]}
            disableAnimation={false}
            enableMouseInteraction
            mouseRadius={0.3}
            colorNum={5}
            waveAmplitude={0.3}
            waveFrequency={2.5}
            waveSpeed={0.02}
        />
        -->

    </div>

    <!-- Foreground content -->
    <div class="relative z-10 flex flex-col items-center gap-8 text-center">
        <h1 class="text-9xl text-text-inverted">
            JUSTIN LEE
        </h1>

        <div class="flex gap-8 list-none justify-center text-text-inverted">
            <li>Front-End UI/UX Developer</li>
            <li>Chicago, IL</li>
            <li>Purdue UX Alumni</li>
            <li>LEGO Enthusiast</li>
        </div>
        <Button variant='primary' size='md'>View my work</Button>
    </div>

    <div class="absolute inset-x-0 bottom-0 z-10 px-8 py-6">
        <p class="text-xl font-heading text-text-secondary">Some text here</p>
    </div>
</main>

<!-- PROJECT SHOWCASE -->
<SectionContainer title="project-showcase" bg='primary'>
    <ContentContainer>
        <div class="flex flex-col items-center justify-center p-16">
            <h1>SHOWASE</h1>
            <p>Projects that define who I am as a designer & devloper.</p>
        </div>
        <div class="grid grid-cols-2 gap-8">
            <ProjectCard
                title="My Project"
                description="A short description of what this project does."
                href="/projects/my-project"
                tags={["Astro", "TypeScript", "Tailwind"]}
                image=https://placehold.net/default.svg
                imageAlt="Screenshot of my project"
            />
            <ProjectCard
                title="My Project"
                description="A short description of what this project does."
                href="/projects/my-project"
                tags={["Astro", "TypeScript", "Tailwind"]}
                image=https://placehold.net/default.svg
                imageAlt="Screenshot of my project"
            />
        </div>
    </ContentContainer>
</SectionContainer>

<!-- ABOUT ME SNIPPET -->
<SectionContainer title="about-me" bg='secondary'>
    <ContentContainer>
        <div class="grid grid-cols-2 gap-8 pt-16">
            <div>
                <h1>JUSTIN LEE</h1>
                <h2>SUBTITLE</h2>
                <p>about me here</p>
            </div>
            <img src="https://placehold.net/default.svg"/>
        </div>
        
    </ContentContainer>
</SectionContainer>

