---
import Button from '../components/Button.astro'
---
<!-- HERO HEADER -->
<main class="bg-blue-500 h-screen w-full flex items-center justify-center flex-col">
    <div class="flex flex-col items-center gap-8 text-center ">
        <h1 class="text-9xl">JUSTIN LEE</h1>
        <div class="flex gap-8 list-none justify-center">
            <li>Front-End UI/UX Developer</li>
            <li>Chicago, IL</li>
            <li>Purdue UX Alumni</li>
            <li>LEGO Enthusiast</li>
        </div>
        <Button variant='primary' size='md' >View my work</Button>
    </div>
    <div class="absolute inset-x-0 bottom-0 px-8 py-6">
        <p class="text-xl font-heading">Some text here</p>
    </div>
</main>

<!-- PROJECT SHOWCASE -->
<section class="p-12 w-full flex items-center justify-center">
    <div class=" flex flex-col items-center justify-center">
        <h1>SHOWCASE</h1>
        <p>This is a subtitle for Showcase.</p>
    </div>
</section>
