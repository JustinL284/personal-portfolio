---
import Button from '../components/Button.astro'
import DecryptedText from '../components/DecryptedText';

type NavItem = {
    href: string;
    label: string;
    variant: 'primary' | 'secondary';
};

const navItems: NavItem[] = [
    { href: '/sandbox', label: 'Sandbox', variant: 'secondary' },
    { href: '/work', label: 'Work', variant: 'secondary' },
    { href: '/about', label: 'About', variant: 'secondary' },
    { href: '/contact', label: 'Get in touch', variant: 'primary' },
]
---
<!-- "nav" is the navigation bar wrapper, it controls the stickiness & position from top of screen-->
<nav class="fixed w-full z-20 top-4 inset-x-0">

    <!-- this "div" controls all content in navigation bar -->
    <div class="bg-surface-primary flex justify-between items-center p-4 rounded-full max-w-8/10 mx-auto">
        <li class="list-none">
            <a class="font-heading text-text-primary text-3xl pl-4" href="/">
                <span class="sr-only">Justin Lee</span>
                    <DecryptedText class=""
                        text="JUSTIN LEE"
                        speed={50}
                        maxIterations={10}
                        sequential
                        revealDirection="start"
                        animateOn="hover"
                        className="revealed-text"
                        encryptedClassName="scrambled-text"
                        client:load
                        />
            </a>
        </li>   

        <!-- this "navItems div" controls navigation bar buttons-->
        <div class="flex items-center gap-2">
            {navItems.map(item => (
                    <li class="list-none">
                        <Button variant={item.variant} size="md" href={item.href}>
                            {item.label}
                        </Button>
                    </li>
                ))}
        </div>
    </div>
</nav>

