---
interface Props {
  title: string;
  description: string;
  href: string;
  tags: string[];
  image: string;      // imported asset .src or a public/ path
  imageAlt?: string;
}

import Button from "./Button.astro";

const { title, description, href, tags, image, imageAlt = "" } = Astro.props;
---

<article class="bg-surface-secondary overflow-hidden rounded-2xl">
    <div class="h-52">
        <img src={image} alt={imageAlt} class="h-full w-full object-cover"/>
    </div>
    <div class="p-6">
        <h3 class="text-text-primary text-3xl mb-2.5">{title}</h3>
        <p class="text-text-secondary text-base mb-4 ">{description}</p>
        <ul class="mb-5 flex flex-wrap gap-2">
            {
                tags.map((tag) => (
                    <li class="text-text-primary border border-border-primary rounded-full px-3 py-1 text-xs">
                    {tag}
                    </li>
                ))
            }
        </ul>   
        <Button href={href}>View project</Button>
    </div>
</article>