<style is:global>
  @import "../styles/global.css";
</style>

<!DOCTYPE html>
<html lang="en">
    <head>
        <!-- Basic Meta Tags -->
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <!-- OpenGraph Preview Meta Tags -->
        <meta property="og:title" content="Justin Lee's Design Portfolio" />
        <meta property="og:description" content="Same or similar to meta description" />
        <meta property="og:image" content="https://yourdomain.com/og-image.png" />
        <meta property="og:url" content="https://yourdomain.com/current-page" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Justin Lee's Design Portfolio" />
        <meta property="og:locale" content="en_US" />

        <!-- Favicon and App Icons -->
        <link rel="icon" type="image/svg+xml" href="/JL-favicon.svg" />
        <link rel="icon" href="/JL-favicon.ico" sizes="32x32" />
        <!-- <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" /> -->

        <!-- Browser Theme Color 
        <meta name="theme-color" content="#111827" />
        <meta name="color-scheme" content="light dark" />
        -->

        <!-- Astro Generator Meta Tag -->
        <meta name="generator" content={Astro.generator} />

        <!-- Page Title and Description -->
        <title>Justin Lee's Design Portfolio</title>
        <meta name="description" content="A concise 150-160 char summary of the page." />
    </head>
    <body>
        <slot /> <!-- Slot is a place for content to be inserted in the layout. -->
    </body>
</html>

<style>
    html, body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>